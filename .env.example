# Copy to .env.local and fill in. Also set these in Vercel → Settings → Environment Variables.
# Your Calendly event link, embedded on /book-a-call. Without it, that page shows a setup placeholder.
VITE_CALENDLY_URL=
# Optional: shown in the final CTA, footer, and the scheduling placeholder when set.
VITE_CONTACT_EMAIL=
# Optional: Privacy Policy link in the footer.
VITE_PRIVACY_URL=
